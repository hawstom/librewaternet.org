# Task 479: /app is a pretty URL over the suite, which still lives at /engcalcs/.
# Internal rewrite, no R flag, so the address bar keeps /app. Both /app and /app/
# are matched: ecSwMounts() declares the mount as '/app/', a person types '/app'.
#
# SCRIPT_NAME under this rule is /engcalcs/Looped-Network.php, so ec_canonical_url()
# emits the long URL. Making /app canonical is a CODE change, not a server one --
# ROADMAP 479.01.
#
# NO `Options` LINE HERE, DELIBERATELY. An Options directive where AllowOverride
# Options is not granted returns 500 for EVERY request under this path, with no
# partial symptom. The ./engcalcs symlink relies on SymLinksIfOwnerMatch instead.
RewriteEngine On
RewriteRule ^app/?$ /engcalcs/Looped-Network.php [L]
#
# THE BLOCK BELOW IS cPANEL'S AND IT IS LOAD-BEARING. Setting this vhost's PHP
# version in MultiPHP Manager WRITES it here, and it is how ea-php83 is actually
# applied. Delete it and the vhost falls back to the account default, which is
# ea-php56, on which lib/config.inc.php is a PARSE ERROR (it uses ??, PHP 7.0+)
# and every page under /engcalcs/ and /app returns 500. Leave it alone; cPanel
# rewrites it whenever the version changes.

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php83” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
